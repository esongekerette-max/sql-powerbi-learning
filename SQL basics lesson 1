-- SQL Basics: Lesson 1
-- Creating a simple customer table

CREATE TABLE customers (
    customer_id INT,
    customer_name VARCHAR(100),
    email VARCHAR(100),
    city VARCHAR(50)
);

-- Add some sample customers

INSERT INTO customers (customer_id, customer_name, email, city)
VALUES
(1, 'John', 'john@email.com', 'Uyo'),
(2, 'Mary', 'mary@email.com', 'Lagos'),
(3, 'David', 'david@email.com', 'Abuja');

-- View all customers

SELECT * FROM customers;
